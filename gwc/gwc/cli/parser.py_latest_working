"""Command-line argument parser for Galaxy Workflow Checker."""

import argparse
from pathlib import Path


def parse_version_spec(spec: str, default: str) -> tuple:
    """Split ID[:VERSION] into (id_or_entry, version_spec)."""
    if ":" in spec:
        left, version = spec.split(":", 1)
        return left.strip(), version.strip()
    return spec.strip(), default


def add_hub_arguments(subparsers, parent_parser):
    """Add the 'hub' subcommand for WorkflowHub REST API operations."""
    hub_parser = subparsers.add_parser(
        'hub',
        parents=[parent_parser],
        help='Interact with WorkflowHub REST API (metadata, projects, RO‑Crate)'
    )
    hub_subparsers = hub_parser.add_subparsers(dest='hub_action', required=True)

    # list-mine
    mine_parser = hub_subparsers.add_parser('list-mine', parents=[parent_parser],
                                            help='List workflows you contributed to')
    mine_parser.add_argument('--token-file', help='Path to token file')
    mine_parser.add_argument('--format', choices=['table', 'tsv', 'json'], default='table')

    # list-project
    project_parser = hub_subparsers.add_parser('list-project', parents=[parent_parser],
                                               help='List workflows in a project')
    project_parser.add_argument('project_id', nargs='?', help='Project ID (defaults to configured projects)')
    project_parser.add_argument('--class', dest='workflow_class', help='Filter by workflow class (e.g., galaxy)')
    project_parser.add_argument('--token-file', help='Path to token file')
    project_parser.add_argument('--format', choices=['table', 'tsv', 'json'], default='table')

    # get
    get_parser = hub_subparsers.add_parser('get', parents=[parent_parser],
                                           help='Get detailed metadata for a workflow')
    get_parser.add_argument('workflow_id', help='Workflow ID')
    get_parser.add_argument('--token-file', help='Path to token file')
    get_parser.add_argument('--format', choices=['table', 'tsv', 'json'], default='table')

    # list-related
    related_parser = hub_subparsers.add_parser('list-related', parents=[parent_parser],
                                               help='List related items (data, publications, etc.)')
    related_parser.add_argument('workflow_id', help='Workflow ID')
    related_parser.add_argument('--token-file', help='Path to token file')
    related_parser.add_argument('--format', choices=['table', 'tsv', 'json'], default='table')

    # download-rocrate
    rocrate_parser = hub_subparsers.add_parser('download-rocrate', parents=[parent_parser],
                                               help='Download RO-Crate zip')
    rocrate_parser.add_argument('workflow_id', help='Workflow ID')
    rocrate_parser.add_argument('--output-dir', help='Output directory (default: current)')
    rocrate_parser.add_argument('--token-file', help='Path to token file')


def parse_args():
    """Parse command-line arguments with subcommands."""
    # Create a parent parser with global options (shared by all subcommands)
    parent_parser = argparse.ArgumentParser(add_help=False)
    parent_parser.add_argument("--config", "-c", help="Path to configuration file")
    parent_parser.add_argument("--verbose", "-v", action="store_true",
                               help="Enable verbose output (DEBUG level logging)")
    parent_parser.add_argument("--log-file", help="Path to log file")

    # Main parser – inherits global options from parent_parser
    parser = argparse.ArgumentParser(
        description="Galaxy Workflow Tool Checker with listing and Hub metadata",
        parents=[parent_parser],
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  # Check a workflow from WorkflowHub
  gwc check 645

  # Check a Dockstore workflow
  gwc check github.com/iwc-workflows/Assembly/main

  # List published workflows on a Galaxy instance
  gwc list --galaxy-url https://usegalaxy.org.au

  # List workflows you contributed to on WorkflowHub
  gwc hub list-mine

  # Get metadata for a WorkflowHub workflow
  gwc hub get 403
"""
    )

    subparsers = parser.add_subparsers(dest='command', required=True, help='Command to execute')

    # -------------------------------------------------------------------------
    # CHECK SUBCOMMAND
    # -------------------------------------------------------------------------
    check_parser = subparsers.add_parser('check', parents=[parent_parser],
                                         help='Validate a workflow against a Galaxy instance')
    check_parser.add_argument('workflow', nargs='?', help='Workflow ID, Dockstore path, or local .ga file')
    check_parser.add_argument('--version', help='Specific version (default: latest)', default='latest')
    check_parser.add_argument('--galaxy-url', help='Galaxy instance URL (default: from config or profile)')
    check_parser.add_argument('--profile', default='galaxy_profile', help='Planemo profile name')
    check_parser.add_argument('--output', '-o', default='workflow_check_report', help='Report base name')
    check_parser.add_argument('--workspace', '-w', default='./workflow_workspace', help='Download directory')
    check_parser.add_argument('--format', choices=['txt', 'json', 'html', 'all'], default='all')
    check_parser.add_argument('--parallel', action='store_true', help='Process in parallel')
    check_parser.add_argument('--max-workers', type=int, default=5, help='Parallel workers')
    check_parser.add_argument('--no-cache', action='store_true', help='Disable tool cache')
    check_parser.add_argument('--static-only', action='store_true', help='Run only structural/wiring checks')
    check_parser.add_argument('--export-install-script', action='store_true', help='Generate installation script')
    check_parser.add_argument('--export-tool-issues-csv', action='store_true', help='Export tool issues to CSV')
    check_parser.add_argument('--compare-workflows', action='store_true', help='Compare workflows (batch only)')

    # CSV and search options (for batch mode)
    check_parser.add_argument('--csv', help='CSV file with columns: name,registry,registry_id,recommended_version')
    check_parser.add_argument('--search', '-s', help='Search term for registries')
    check_parser.add_argument('--id', nargs='+', metavar='ID[:VERSION]', help='WorkflowHub ID(s)')
    check_parser.add_argument('--entry', '-e', nargs='+', metavar='ENTRY[:VERSION]', help='Dockstore entry(s)')
    check_parser.add_argument('--source', choices=['workflowhub', 'dockstore', 'both'], default='both')
    check_parser.add_argument('--max-workflows', type=int, default=10, help='Max results for search')
    check_parser.add_argument('--local-file', help='Local .ga file to check')

    # -------------------------------------------------------------------------
    # LIST SUBCOMMAND
    # -------------------------------------------------------------------------
    list_parser = subparsers.add_parser('list', parents=[parent_parser],
                                        help='List published workflows on a Galaxy instance')
    list_parser.add_argument('--galaxy-url', help='Galaxy instance URL (default: from config or profile)')
    list_parser.add_argument('--api-key', help='Galaxy API key (optional)')
    list_parser.add_argument('--profile', default='galaxy_profile', help='Planemo profile name')
    list_parser.add_argument('--search', help='Filter by name/description')
    list_parser.add_argument('--tag', help='Filter by tag')
    list_parser.add_argument('--stats', action='store_true', help='Show statistics instead of listing')
    list_parser.add_argument('--limit', type=int, default=50, help='Max workflows to show (0 for all)')
    list_parser.add_argument('--output', help='Export to CSV/TSV (extension decides)')

    # -------------------------------------------------------------------------
    # HUB SUBCOMMAND
    # -------------------------------------------------------------------------
    add_hub_arguments(subparsers, parent_parser)

    args = parser.parse_args()

    # For 'check' with no workflow but with batch options, allow it.
    if args.command == 'check':
        if not args.workflow and not args.csv and not args.local_file and not args.search and not args.id and not args.entry:
            parser.error("check requires either a workflow identifier or one of: --csv, --local-file, --search, --id, --entry")

    return args
